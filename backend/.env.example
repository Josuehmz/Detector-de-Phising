# Configuración del LLM para PhishGuard
# Opciones para PHISHGUARD_LLM: "gemini", "claude", "stub"
PHISHGUARD_LLM=gemini

# Para usar Google Gemini:
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Modelo opcional (por defecto gemini-3.8-flash):
# PHISHGUARD_MODELO=gemini-3.8-flash

# Para usar Anthropic Claude (si se elige PHISHGUARD_LLM=claude):
# ANTHROPIC_API_KEY=tu_api_key_de_anthropic_aqui
